<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Messages, received messages and the manager hand out shared handles by design. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- The manager constructor connects to Redis and propagates the connection failure to the caller. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
</FindBugsFilter>
